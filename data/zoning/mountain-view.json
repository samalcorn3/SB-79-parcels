{
  "id": "mountain-view",
  "name": "City of Mountain View",
  "jurisdictions": [
    "Mountain View"
  ],
  "publisher": "City of Mountain View — Zoning Districts",
  "url": "https://maps.mountainview.gov/arcgis/rest/services/Public/ZoningDistrict/MapServer/0",
  "fields": {
    "code": "ZONELABEL",
    "category": "ZONECLASS"
  },
  "rules": [
    {
      "on": "category",
      "match": "^(CN|CS)$",
      "class": "commercial",
      "cite": "Mountain View City Code Ch. 36, Art. IV (commercial districts)"
    },
    {
      "on": "category",
      "match": "^CO$",
      "class": "office",
      "cite": "Mountain View City Code Ch. 36 (commercial-office)"
    },
    {
      "on": "category",
      "match": "^CRA$",
      "class": "mixed-residential",
      "cite": "Mountain View City Code Ch. 36 (commercial-residential-arterial)"
    },
    {
      "on": "category",
      "match": "^(ML|MM)$",
      "class": "industrial",
      "cite": "Mountain View City Code Ch. 36 (industrial districts)"
    },
    {
      "on": "category",
      "match": "^P$",
      "class": "planned",
      "cite": "Mountain View precise plans"
    },
    {
      "on": "category",
      "match": "^PF$",
      "class": "public"
    },
    {
      "on": "category",
      "match": "^(R1|R2|R3|R4|RMH)$",
      "class": "residential",
      "cite": "Mountain View City Code Ch. 36 (residential districts)"
    },
    {
      "on": "category",
      "match": "^A$",
      "class": "agriculture"
    },
    {
      "on": "category",
      "match": "^F$",
      "class": "open-space"
    }
  ],
  "generic": false,
  "updatedField": "LASTUPDATE",
  "codeName": "Mountain View City Code, Ch. 36"
