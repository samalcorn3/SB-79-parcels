    {
      "match": "^MIL$",
      "class": "unknown",
      "why": "Military land (Naval Weapons Station)."
    },
    {
      "match": "^OE$",
      "class": "industrial"
    },
    {
      "match": "^BEA$",
      "class": "open-space"
    }
  ],
  "generic": true
