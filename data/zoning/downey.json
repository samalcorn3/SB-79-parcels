  "fields": {
    "code": "Zone_landType",
    "description": "Zone"
  },
  "rules": [
    {
      "match": "Specific Plan|Master Plan",
      "class": "planned",
      "cite": "Downey specific and master plans"
    },
    {
      "match": "^Commercial Zones$",
      "class": "commercial",
      "cite": "Downey Municipal Code, Art. IX (commercial zones)"
    },
    {
      "match": "^Manufacture Zones$",
      "class": "industrial",
      "cite": "Downey Municipal Code, Art. IX (manufacturing zones)"
    },
    {
      "match": "^Residential Zones$",
      "class": "residential",
      "cite": "Downey Municipal Code, Art. IX (residential zones)"
    }
  ],
  "generic": true,
  "codeName": "Downey Municipal Code, Art. IX"
}
