{
  "schemaVersion": 2,
  "notes": [
    "Zoning layers, queried live, and how each jurisdiction's zones answer AB 2011's first site test: is the site 'in a zone where office, retail, or parking are a principally permitted use' (Gov. Code §§ 65912.111(a), 65912.121(a))?",
    "'Principally permitted use' = a use that may occupy more than one-third of the square footage on the site without a conditional use permit; parking uses count whether or not they need a CUP (§ 65912.101(u)).",
    "Each source lists rules, tried in order: a regular expression on the zone code (or on the city's own zone category) and the class of zone it denotes. Classes carry the status; a rule may override it. Only a jurisdiction's own current zoning layer is used; where none is configured the test is reported as not evaluated.",
    "Each jurisdiction's layer and rules live in data/zoning/<id>.json, loaded only when a parcel there is looked up. The index below says which file serves which city or unincorporated county; regenerate it with `npm run zoning:index` after adding or renaming a file."
  ],
  "classes": {
    "commercial": {
      "status": "meets",
      "label": "Commercial zone",
      "why": "Retail and office uses are permitted by right in this jurisdiction's commercial zones."
    },
    "office": {
      "status": "meets",
      "label": "Office zone",
      "why": "Office uses are permitted by right in this zone."
    },
    "parking": {
      "status": "meets",
      "label": "Parking zone",
      "why": "Parking is the zone's purpose, and parking uses are principally permitted even where a conditional use permit is required (§ 65912.101(u))."
    },
    "mixed-commercial": {
      "status": "meets",
      "label": "Commercial or employment mixed-use zone",
      "why": "Retail and office uses are permitted by right without a floor-area cap."
    },
    "mixed-residential": {
      "status": "confirm",
      "label": "Residential-led mixed-use zone",
      "why": "Commercial uses are permitted, but often only on the ground floor or as a share of floor area; whether office or retail may exceed one-third of the square footage depends on the zone's standards."
    },
    "industrial": {
      "status": "confirm",
      "label": "Industrial zone",
      "why": "Industrial zones often permit office or parking uses (parking counts even with a conditional use permit); check the zone's use table. Note AB 2011's separate industrial-use tests (§§ 65912.111(d), 65912.121(f))."
    },
    "residential": {
      "status": "fails",
      "label": "Residential zone",
      "why": "Residential zones do not permit office or retail uses, and parking is allowed only as accessory to the homes. If this jurisdiction's code permits a parking use in this zone, even with a conditional use permit, the site would qualify (§ 65912.101(u))."
    },
    "public": {
      "status": "confirm",
      "label": "Public or institutional zone",
      "why": "Public facility zones sometimes permit public parking or offices; check the zone's use table."
    },
    "planned": {
      "status": "confirm",
      "label": "Planned development or specific plan district",
      "why": "Permitted uses are set by the district's own ordinance or plan, not the base zoning code."
    },
    "open-space": {
      "status": "fails",
      "label": "Open space or park zone",
      "why": "Open space zones do not permit office, retail, or parking uses."
    },
    "agriculture": {
      "status": "fails",
      "label": "Agricultural zone",
      "why": "Agricultural zones do not permit office or retail uses."
    },
    "transportation": {
      "status": "fails",
      "label": "Transportation or right-of-way zone",
      "why": "Freeway, railroad, and right-of-way zones are not development sites."
    },
    "unknown": {
      "status": "confirm",
      "label": "Zone not classified",
      "why": "This zone code is not in the site's rule table; check the jurisdiction's zoning code."
    }
  },
  "genericRules": {
    "note": "Used after a source's own rules when it sets \"generic\": true. They read the jurisdiction's own description of the zone (or, failing that, widely shared California zone-code prefixes) and cite it.",
    "description": [
      {
        "match": "parking",
        "class": "parking"
      },
      {
        "match": "specific plan|planned (unit |community )?development|master plan|precise plan|planned community|form[- ]based",
        "class": "planned"
      },
      {
        "match": "(commercial|office)[- /]+residential|residential[- /]+(commercial|office)|mixed[- ]?use|multi[- ]use|mixed density",
        "class": "mixed-residential"
      },
      {
        "match": "office|professional",
        "class": "office"
      },
      {
        "match": "industr|manufactur|business park|technology park|research|warehous|light industrial",
        "class": "industrial"
      },
      {
        "match": "residential|single[- ]family|single[- ]unit|multiple[- ]family|multi[- ]family|duplex|townhouse|estate|mobile ?home|dwelling",
        "class": "residential"
      },
      {
        "match": "commercial|retail|shopping|neighborhood business|general business|downtown|town center|village center|business district",
        "class": "commercial"
      },
      {
        "match": "open space|park|recreation|conservation|preserve|golf|cemetery|resource",
        "class": "open-space"
      },
      {
        "match": "agricultur|farm|ranch",
        "class": "agriculture"
      },
      {
        "match": "public|institution|civic|school|government|quasi|community facilit",
        "class": "public"
      },
      {
        "match": "utilit|transportation|right[- ]of[- ]way|freeway|railroad",
        "class": "transportation"
      }
    ],
    "code": [
      {
        "match": "^(PD|PUD|SP|SPA)\\b",
        "class": "planned"
      },
      {
        "match": "^(MU|MX|M-X|CMU|RMU)\\b",
        "class": "mixed-residential"
      },
      {
        "match": "^(C|CC|CG|CN|CR|CS|C-\\d|C\\d|GC|NC|LC|CBD)\\b",
        "class": "commercial"
      },
      {
        "match": "^(CO|C-O|OP|BP|O-P|PO|BPO)\\b",
        "class": "office"
      },
      {
        "match": "^(M|M-\\d|M\\d|I|I-\\d|IL|IG|IP|LI|HI|ML)\\b",
        "class": "industrial"
      },
      {
        "match": "^(R|R-?\\d|RS|RM|RH|RD|RE|RR|RL|SF|MF|RMH|MHP)\\b",
        "class": "residential"
      },
      {
        "match": "^(OS|O-S|POS)\\b",
        "class": "open-space"
      },
      {
        "match": "^(A|AG|A-\\d|A\\d)\\b",
        "class": "agriculture"
      },
      {
        "match": "^(PF|P-F|PQP|PS|P/QP|PL|P/SP)\\b",
        "class": "public"
      }
    ]
  },
