{
  "name": "sb79-parcels",
  "version": "0.1.0",
  "private": true,
  "description": "Parcel-level SB 79 (Gov. Code 65912.155-65912.162) transit-oriented development lookup, querying authoritative MPO, county, and HCD sources live.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node scripts/check-syntax.mjs && node --test tests/*.test.mjs",
    "check:sources": "node scripts/check-sources.mjs",
    "check:hcd": "node scripts/check-hcd.mjs",
    "check:statute": "python3 scripts/statute.py",
    "lookup": "node scripts/lookup.mjs",
    "serve": "python3 -m http.server 8080"
  },
  "devDependencies": {
    "@turf/turf": "7.2.0",
    "leaflet": "^1.9.4"
  }
}
